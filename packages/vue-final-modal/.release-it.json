{
  "github": {
    "release": true
  },
  "npm": {
    "publish": false
  },
  "git": {
    "requireCleanWorkingDir": false,
    "requireBranch": ["release/*", "master"],
    "tagName": "v${version}",
    "commitMessage": "chore(release): vue-final-modal v${version}"
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "angular",
      "infile": "CHANGELOG.md",
      "ignoreRecommendedBump": true
    }
  }
}
